{
  "name": "MVX",
  "version": "0.0.14",
  "manifest_version": 3,
  "permissions": [
    "activeTab",
    "alarms",
    "scripting",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "foobar": {
      "suggested_key": {
        "default": "Ctrl+Shift+J",
        "mac": "MacCtrl+Shift+J"
      },
      "description": "Perform foobar action"
    }
  },
  "action": {
    "default_popup": "popup.html"
  },
//  "sandbox": {
//    "pages": ["popup.html"]
//  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": [],
      "js": ["content-script.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fetch-page.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
